{
  "manifest_version": 3,
  "name": "Droplet – water estimate for Claude chats",
  "short_name": "Droplet",
  "version": "0.2.0",
  "description": "Shows a rough, animated estimate of the data-centre water behind each Claude reply. Runs locally; sends nothing anywhere.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Droplet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
